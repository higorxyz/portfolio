# EmailJS (form de contato) — client-side, prefixo VITE_ obrigatório
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# GitHub — usado SÓ pelas serverless functions em /api (server-side).
# Sem prefixo VITE_ de propósito: isso mantém o valor fora do bundle do
# client. Opcional (sem token o proxy ainda funciona, só com limite de
# 60 req/hora em vez de 5000), mas recomendado.
# Gerar em: https://github.com/settings/tokens (classic, sem escopo nenhum
# marcado — só precisa ler dados públicos)
GITHUB_TOKEN=
